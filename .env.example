# Client (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_APP_URL=http://localhost:3000

# Optional SSR aliases (same values)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Stripe (server-only) — required for paid entries
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # Dashboard → Webhooks → https://YOUR_APP/api/webhooks/stripe
# APP_URL=http://localhost:3000

# Service role — webhook mark-paid, seed, email outbox
# SUPABASE_SERVICE_ROLE_KEY=eyJ…
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co   # optional alias of VITE_SUPABASE_URL

# Emails (Resend) — optional; without key, emails log to email_outbox as skipped_no_key
# RESEND_API_KEY=re_...
# RESEND_FROM=MatComp <onboarding@resend.dev>
